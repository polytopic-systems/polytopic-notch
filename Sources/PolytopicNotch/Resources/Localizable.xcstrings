    "Turn off if %@ isn't really using the notch" : {
      "comment" : "Tooltip; the name is another app",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausschalten, falls %@ die Notch nicht wirklich nutzt"
