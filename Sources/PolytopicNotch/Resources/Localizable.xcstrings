    },
    "Under the notch" : {
      "comment" : "Quiet indicator position option",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter der Notch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bajo la muesca"
          }
        },
        "fr" : {
          "stringUnit" : {
