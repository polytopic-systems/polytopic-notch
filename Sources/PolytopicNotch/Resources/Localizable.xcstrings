        }
      }
    },
    "Left to right in Split, top to bottom in Merged; first in line on a tie otherwise. Drag to reorder." : {
      "comment" : "Split and Merged are sharing style names",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von links nach rechts bei „Geteilt“, von oben nach unten bei „Zusammengeführt“; sonst bei Gleichstand die erste in der Reihe. Zum Umsortieren ziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De izquierda a derecha en Dividido, de arriba abajo en Combinado; si no, en caso de empate, la primera de la fila. Arrastre para reordenar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gauche à droite en Partagé, de haut en bas en Fusionné ; sinon, la première de la file en cas d'égalité. Faites glisser pour réordonner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da sinistra a destra in Diviso, dall'alto in basso in Unito; altrimenti, a parità, vince la prima in fila. Trascina per riordinare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割では左から右、統合では上から下の順です。それ以外では同順位なら先頭が優先されます。ドラッグで並べ替えます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od lewej do prawej w trybie Podział, od góry do dołu w trybie Scalenie; w pozostałych przy remisie wygrywa pierwsza w kolejce. Przeciągnij, aby zmienić kolejność."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trái sang phải ở chế độ Chia đôi, trên xuống dưới ở chế độ Gộp; các trường hợp khác, ứng dụng xếp trước được ưu tiên khi ngang nhau. Kéo để sắp xếp lại."
          }
        }
      }
    },
    "Like Priority, with a dot for each app when you hover; click one to switch." : {
      "comment" : "Priority is a sharing style name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie „Priorität“, mit einem Punkt pro App beim Darüberfahren; klicken Sie auf einen, um zu wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como Prioridad, con un punto por app al pasar el puntero; haga clic en uno para cambiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme Priorité, avec un point par app au survol ; cliquez sur l'un pour basculer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come Priorità, con un punto per ogni app al passaggio del puntatore; fai clic su un punto per passare a quell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先と同様ですが、ポインタを重ねるとアプリごとにドットが表示されます。クリックで切り替えます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak Priorytet, z kropką dla każdej aplikacji po najechaniu; kliknij jedną, aby przełączyć."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Như Ưu tiên, kèm một chấm cho mỗi ứng dụng khi bạn di chuột; bấm vào một chấm để chuyển."
          }
        }
      }
    },
