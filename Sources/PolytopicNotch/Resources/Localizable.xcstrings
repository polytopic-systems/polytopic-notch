    "The app with the most to show gets the notch; the others wait." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App mit dem meisten Inhalt erhält die Notch; die anderen warten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app con más que mostrar ocupa la muesca; las demás esperan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app qui a le plus à afficher obtient l’encoche ; les autres attendent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app con più cose da mostrare ottiene il notch; le altre aspettano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
