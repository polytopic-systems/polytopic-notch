            "value" : "Desactívelo si %@ no está usando realmente la muesca"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez si %@ n’utilise pas vraiment l’encoche"
          }
        },
        "it" : {
          "stringUnit" : {
